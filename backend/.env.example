# ---- LLM provider ----------------------------------------------------------
# Primary provider: gemini | anthropic | openai | mock
SENTINEL_LLM_PROVIDER=gemini
SENTINEL_GOOGLE_API_KEY=your_google_api_key_here
SENTINEL_LLM_MODEL=gemini-2.0-flash
SENTINEL_LLM_REASONING_MODEL=gemini-2.0-flash-thinking-exp

# Set true to run the entire graph with zero network calls (offline demo mode).
SENTINEL_OFFLINE_MODE=false

# ---- External tool APIs (all optional — each has an offline fallback) -------
SENTINEL_OPENWEATHER_API_KEY=your_openweather_api_key_here
SENTINEL_NEWSAPI_KEY=your_newsapi_key_here
SENTINEL_MAPBOX_TOKEN=

# ---- Runtime ---------------------------------------------------------------
SENTINEL_ENV=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
